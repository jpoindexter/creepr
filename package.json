{
  "name": "creepr",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "lsof -ti:3500 | xargs kill -9 2>/dev/null || true; next dev -p ${PORT:-3500}",
    "dev:kill": "lsof -ti:3500 | xargs kill -9 2>/dev/null || true",
    "dev:restart": "npm run dev:kill && npm run dev",
    "build": "next build",
    "start": "next start -p ${PORT:-3500}",
    "lint": "next lint",
    "prepare": "husky",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "npm run lint && npm run typecheck && npm run format:check"
  },
  "dependencies": {
    "@crawlee/playwright": "^3.13.0",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slider": "^1.3.6",
    "@xyflow/react": "^12.3.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dagre": "^0.8.5",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "playwright": "^1.49.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@eslint/eslintrc": "^3.2.0",
    "@types/dagre": "^0.7.52",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.6",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "baseline-browser-mapping": "^2.8.32",
    "eslint": "^9.16.0",
    "eslint-config-next": "^16.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.6",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "shadcn": "^2.1.7",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.7.2"
  }
}
